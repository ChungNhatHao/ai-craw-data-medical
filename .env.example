APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_PATH=state/crawler.db
OUTPUT_ROOT=output
SESSION_ROOT=state/sessions
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_SELECTOR_TIMEOUT_MS=10000
NAVIGATION_MAX_HOPS_PER_ITEM=12
NAVIGATION_MAX_SAME_FINGERPRINT=3
NAVIGATION_MAX_NO_PROGRESS=2
DISEASE_DETAIL_CONFIDENCE_THRESHOLD=0.80
CRAWL_MAX_ITEMS=1000
CRAWL_MAX_PAGES=100
DISCOVERY_MAX_NO_NEW_ROUNDS=2
FETCH_MAX_ATTEMPTS=3
FETCH_RETRY_BASE_SECONDS=2
FETCH_RETRY_MAX_SECONDS=60
CAPTURE_SCREENSHOT=true
PARSE_TIMEOUT_SECONDS=30
PARSE_MAX_MODEL_CALLS=40
PARSE_MAX_INPUT_CHARS=200000

AGENTIC_DISCOVERY_ENABLED=false
AI_NORMALIZATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_NAVIGATION_MODEL=gemini-3.5-flash-lite
GEMINI_DETECTOR_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_NORMALIZATION_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=20
GEMINI_RETRY_MAX_SECONDS=60
GEMINI_MAX_CALLS_PER_JOB=100
GEMINI_MAX_INPUT_CHARS=30000
GEMINI_DISEASE_CONFIDENCE_THRESHOLD=0.85

GENRE_MANUALS_BASE_URL=https://www.genre-manuals.com/sites/CLUE/home.html
GENRE_MANUALS_USERNAME=
GENRE_MANUALS_PASSWORD=
