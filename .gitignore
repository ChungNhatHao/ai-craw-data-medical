# Secrets and local configuration
.env
.env.*
!.env.example

# Python environments and generated files
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/

# Test, lint, type-check and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Browser runtimes and authenticated sessions
.playwright-browsers/
sessions/
playwright-report/
test-results/

# Crawl artifacts, logs and runtime state
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep
state/*
!state/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# IDE and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
